# =============================================================================
# ABHI MOCK TEST — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================================

# Database connection string
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret
# REQUIRED in production. Must be a cryptographically strong random string (min 256 bits / 64 hex chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your_secure_random_jwt_secret_key_here"

# Admin credentials (used for initial database seed only)
ADMIN_EMAIL="admin@abhimocktest.com"
ADMIN_PASSWORD="your_secure_admin_password_here"

# Gemini API Key (required for AI Mentor feature)
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# Application URL
APP_URL="http://localhost:3000"

# Node environment (development | production)
NODE_ENV="development"

# Server port (default: 3000)
PORT="3000"

# CORS allowed origins (comma-separated, used in production)
# Example: https://abhi-mock-test.pages.dev,https://your-custom-domain.com
# ALLOWED_ORIGINS="https://abhi-mock-test.pages.dev"
