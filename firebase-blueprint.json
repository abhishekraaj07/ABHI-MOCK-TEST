{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Candidate aspirant profile and settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["USER", "ADMIN"] },
        "targetExam": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "Attempt": {
      "title": "Mock Test Attempt",
      "description": "User test submissions and scorecard data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "testId": { "type": "string" },
        "testTitle": { "type": "string" },
        "examName": { "type": "string" },
        "score": { "type": "number" },
        "totalMarks": { "type": "number" },
        "percentage": { "type": "number" },
        "accuracy": { "type": "number" },
        "timeTaken": { "type": "number" },
        "status": { "type": "string" },
        "startedAt": { "type": "string" },
        "submittedAt": { "type": "string" },
        "correctCount": { "type": "number" },
        "wrongCount": { "type": "number" },
        "unansweredCount": { "type": "number" }
      },
      "required": ["id", "userId", "testId", "score"]
    },
    "Bookmark": {
      "title": "Bookmarked Question",
      "description": "Question bookmarked by user for revision",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "questionId": { "type": "string" },
        "testTitle": { "type": "string" },
        "questionText": { "type": "string" },
        "subjectName": { "type": "string" },
        "topicName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "questionId"]
    },
    "ChatMessage": {
      "title": "Gemini Chat Message",
      "description": "Multi-turn Gemini chat mentor message history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model", "system"] },
        "model": { "type": "string" },
        "persona": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "userId", "role", "content"]
    }
  }
}
